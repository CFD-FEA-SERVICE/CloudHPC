###############################################################################
#
# LIGGGHTS 3.8.0 - filling of a cylindrical silo with spherical particles
#
# 1200 spheres of 3 mm radius are inserted in packets at the top of a
# 0.10 m diameter, 0.40 m tall silo and settle under gravity onto the flat
# bottom. The silo wall and the bottom are modelled as analytical ("primitive")
# walls, so no STL geometry file is needed and the case is self-contained.
#
# The run is a pure DEM problem: it scales with the number of particles, so
# raise the particle count (and the vCPU requested on cloudHPC) to turn it
# into a heavier benchmark.
#
###############################################################################

# ---------------------------------------------------------------- simulation
atom_style      granular
atom_modify     map array
boundary        f f f
newton          off

communicate     single vel yes

units           si

region          domain block -0.06 0.06 -0.06 0.06 0.0 0.45 units box
create_box      1 domain

neighbor        0.003 bin
neigh_modify    delay 0

# ------------------------------------------------------- material properties
fix             m1 all property/global youngsModulus peratomtype 5.e6
fix             m2 all property/global poissonsRatio peratomtype 0.45
fix             m3 all property/global coefficientRestitution peratomtypepair 1 0.3
fix             m4 all property/global coefficientFriction peratomtypepair 1 0.5

# ------------------------------------------------------------- contact model
pair_style      gran model hertz tangential history
pair_coeff      * *

timestep        0.00001

fix             gravi all gravity 9.81 vector 0.0 0.0 -1.0

# --------------------------------------------------------------------- walls
# cylindrical silo of radius 0.05 m, centred on the z axis, with a flat bottom
fix             silowall all wall/gran model hertz tangential history &
                primitive type 1 zcylinder 0.05 0. 0.
fix             bottom all wall/gran model hertz tangential history &
                primitive type 1 zplane 0.0

# --------------------------------------------------------- particle template
fix             pts1 all particletemplate/sphere 15485863 atom_type 1 &
                density constant 2500 radius constant 0.003
fix             pdd1 all particledistribution/discrete 15485867 1 pts1 1.0

# ----------------------------------------------------------------- insertion
region          insreg cylinder z 0.0 0.0 0.045 0.28 0.43 units box

fix             ins all insert/pack seed 32452843 distributiontemplate pdd1 &
                maxattempt 200 insert_every 2000 overlapcheck yes all_in yes &
                vel constant 0. 0. -0.5 region insreg &
                particles_in_region 1200 ntry_mc 10000

# ---------------------------------------------------------------- integrator
fix             integr all nve/sphere

# -------------------------------------------------------------------- output
thermo_style    custom step atoms ke vol
thermo          1000
thermo_modify   lost ignore norm no
compute_modify  thermo_temp dynamic yes

shell           mkdir post
dump            dmp all custom 5000 post/dump*.liggghts &
                id type x y z vx vy vz fx fy fz omegax omegay omegaz radius

# ----------------------------------------------------------------------- run
# 1.0 s of physical time: enough to insert every particle and let the bed settle
run             100000
