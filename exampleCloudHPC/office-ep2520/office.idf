    0.0,                     !- X Origin {m}
    0.0,                     !- Y Origin {m}
    0.0,                     !- Z Origin {m}
    1,                       !- Type
    1,                       !- Multiplier
    3.0,                     !- Ceiling Height {m}
    240.0;                   !- Volume {m3}

