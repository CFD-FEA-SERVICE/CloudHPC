!-   ==========================================================================
!-   Single-zone office - EnergyPlus 25.2.0
!-
!-   A 10 x 8 x 3 m open-plan office in Rome, served by an ideal-loads air
!-   system. The model runs on sizing periods only (a winter and a summer
!-   design day), so no .epw weather file is needed and the case is fully
!-   self-contained.
!-
!-   To run a full annual simulation instead, drop a weather file next to this
!-   .idf, add a RunPeriod object and set "Run Simulation for Weather File Run
!-   Periods" to Yes in SimulationControl.
!-   ==========================================================================

Version,
    25.2;                    !- Version Identifier

SimulationControl,
    Yes,                     !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    Yes,                     !- Run Simulation for Sizing Periods
    No,                      !- Run Simulation for Weather File Run Periods
    No,                      !- Do HVAC Sizing Simulation for Sizing Periods
    1;                       !- Maximum Number of HVAC Sizing Simulation Passes

Building,
    Single-zone office,      !- Name
    0.0,                     !- North Axis {deg}
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value {W}
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExterior, !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days

Timestep,
    6;                       !- Number of Timesteps per Hour

GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    CounterClockWise,        !- Vertex Entry Direction
    World;                   !- Coordinate System

!-   -------------------------------------------------------------- location

Site:Location,
    Rome,                    !- Name
    41.80,                   !- Latitude {deg}
    12.60,                   !- Longitude {deg}
    1.00,                    !- Time Zone {hr}
    20.0;                    !- Elevation {m}

SizingPeriod:DesignDay,
    Rome winter design day,  !- Name
    1,                       !- Month
    21,                      !- Day of Month
    WinterDesignDay,         !- Day Type
    0.0,                     !- Maximum Dry-Bulb Temperature {C}
    0.0,                     !- Daily Dry-Bulb Temperature Range {deltaC}
    ,                        !- Dry-Bulb Temperature Range Modifier Type
    ,                        !- Dry-Bulb Temperature Range Modifier Day Schedule Name
    Wetbulb,                 !- Humidity Condition Type
    0.0,                     !- Wetbulb at Maximum Dry-Bulb {C}
    ,                        !- Humidity Condition Day Schedule Name
    ,                        !- Humidity Ratio at Maximum Dry-Bulb
    ,                        !- Enthalpy at Maximum Dry-Bulb {J/kg}
    ,                        !- Daily Wet-Bulb Temperature Range {deltaC}
    101100.0,                !- Barometric Pressure {Pa}
    4.9,                     !- Wind Speed {m/s}
    0.0,                     !- Wind Direction {deg}
    No,                      !- Rain Indicator
    No,                      !- Snow Indicator
    No,                      !- Daylight Saving Time Indicator
    ASHRAEClearSky,          !- Solar Model Indicator
    ,                        !- Beam Solar Day Schedule Name
    ,                        !- Diffuse Solar Day Schedule Name
    ,                        !- ASHRAE Clear Sky Optical Depth for Beam Irradiance
    ,                        !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance
    0.0;                     !- Sky Clearness

SizingPeriod:DesignDay,
    Rome summer design day,  !- Name
    7,                       !- Month
    21,                      !- Day of Month
    SummerDesignDay,         !- Day Type
    33.0,                    !- Maximum Dry-Bulb Temperature {C}
    11.0,                    !- Daily Dry-Bulb Temperature Range {deltaC}
    ,                        !- Dry-Bulb Temperature Range Modifier Type
    ,                        !- Dry-Bulb Temperature Range Modifier Day Schedule Name
    Wetbulb,                 !- Humidity Condition Type
    22.0,                    !- Wetbulb at Maximum Dry-Bulb {C}
    ,                        !- Humidity Condition Day Schedule Name
    ,                        !- Humidity Ratio at Maximum Dry-Bulb
    ,                        !- Enthalpy at Maximum Dry-Bulb {J/kg}
    ,                        !- Daily Wet-Bulb Temperature Range {deltaC}
    101100.0,                !- Barometric Pressure {Pa}
    3.6,                     !- Wind Speed {m/s}
    250.0,                   !- Wind Direction {deg}
    No,                      !- Rain Indicator
    No,                      !- Snow Indicator
    No,                      !- Daylight Saving Time Indicator
    ASHRAEClearSky,          !- Solar Model Indicator
    ,                        !- Beam Solar Day Schedule Name
    ,                        !- Diffuse Solar Day Schedule Name
    ,                        !- ASHRAE Clear Sky Optical Depth for Beam Irradiance
    ,                        !- ASHRAE Clear Sky Optical Depth for Diffuse Irradiance
    1.0;                     !- Sky Clearness

! Monthly ground temperatures under the slab. Without this object EnergyPlus
! falls back to a constant 18 C and issues a warning.
Site:GroundTemperature:BuildingSurface,
    18.0,                    !- January Ground Temperature {C}
    18.0,                    !- February Ground Temperature {C}
    18.2,                    !- March Ground Temperature {C}
    18.6,                    !- April Ground Temperature {C}
    19.4,                    !- May Ground Temperature {C}
    20.1,                    !- June Ground Temperature {C}
    20.6,                    !- July Ground Temperature {C}
    20.7,                    !- August Ground Temperature {C}
    20.3,                    !- September Ground Temperature {C}
    19.6,                    !- October Ground Temperature {C}
    18.9,                    !- November Ground Temperature {C}
    18.3;                    !- December Ground Temperature {C}

!-   ------------------------------------------------------------- materials

Material,
    Brick,                   !- Name
    MediumRough,             !- Roughness
    0.100,                   !- Thickness {m}
    0.890,                   !- Conductivity {W/m-K}
    1920.0,                  !- Density {kg/m3}
    790.0;                   !- Specific Heat {J/kg-K}

Material,
    Insulation,              !- Name
    Rough,                   !- Roughness
    0.080,                   !- Thickness {m}
    0.036,                   !- Conductivity {W/m-K}
    30.0,                    !- Density {kg/m3}
    1200.0;                  !- Specific Heat {J/kg-K}

Material,
    Gypsum board,            !- Name
    Smooth,                  !- Roughness
    0.013,                   !- Thickness {m}
    0.160,                   !- Conductivity {W/m-K}
    800.0,                   !- Density {kg/m3}
    1090.0;                  !- Specific Heat {J/kg-K}

Material,
    Concrete slab,           !- Name
    MediumRough,             !- Roughness
    0.200,                   !- Thickness {m}
    1.730,                   !- Conductivity {W/m-K}
    2243.0,                  !- Density {kg/m3}
    837.0;                   !- Specific Heat {J/kg-K}

WindowMaterial:SimpleGlazingSystem,
    Double glazing,          !- Name
    1.600,                   !- U-Factor {W/m2-K}
    0.400,                   !- Solar Heat Gain Coefficient
    0.700;                   !- Visible Transmittance

Construction,
    Exterior wall,           !- Name
    Brick,                   !- Outside Layer
    Insulation,              !- Layer 2
    Gypsum board;            !- Layer 3

Construction,
    Exterior roof,           !- Name
    Concrete slab,           !- Outside Layer
    Insulation,              !- Layer 2
    Gypsum board;            !- Layer 3

Construction,
    Ground floor,            !- Name
    Concrete slab;           !- Outside Layer

Construction,
    Exterior window,         !- Name
    Double glazing;          !- Outside Layer

