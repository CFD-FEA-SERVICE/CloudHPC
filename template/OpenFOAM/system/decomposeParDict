FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Automatically updated by cloudHPC to match the vCPU selected
// (highcore/hypercore: 1 subdomain per vCPU, other instances: 1 per 2 vCPU)
numberOfSubdomains 4;

// Suggested method: scotch (no extra coefficients required)
method   scotch;

